@page
@model CasePriority.Web.Pages.Cases.CreateModel
@{
    ViewData["Title"] = "New case";
}

<h1 class="h3 mb-3">New case</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="Input.CaseNumber" class="form-label">Case number</label>
        <input asp-for="Input.CaseNumber" class="form-control" />
        <span asp-validation-for="Input.CaseNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Subject" class="form-label">Subject</label>
        <input asp-for="Input.Subject" class="form-control" />
        <span asp-validation-for="Input.Subject" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Severity" class="form-label">Severity (1–5)</label>
        <input asp-for="Input.Severity" type="number" min="1" max="5" class="form-control" />
        <span asp-validation-for="Input.Severity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a class="btn btn-outline-secondary" asp-page="/Cases/Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
